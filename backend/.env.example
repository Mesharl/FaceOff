NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=https://your-web-domain.example
DATABASE_URL=postgresql://user:password@host:5432/faceoff
DATABASE_SSL=true
REDIS_URL=redis://default:password@host:6379

# Google Play purchase verification
GOOGLE_PLAY_PACKAGE_NAME=com.familyfeud.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}

# Only use for local development. NEVER enable in production.
ALLOW_UNVERIFIED_PURCHASES=false

# AdMob SSV callback must point to:
# https://YOUR_API_DOMAIN/api/admob/ssv
